          & .\iniciar.ps1 -Ref $env:SOURCE_SHA -SomenteValidar
        timeout-minutes: 15

      - name: Compilar os scripts
        shell: powershell
        run: |
          $ErrorActionPreference = 'Stop'
          powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\montar-portatil.ps1
          if ($LASTEXITCODE -ne 0) { throw 'Compilacao falhou.' }
          foreach ($arq in @('otimizadorpc.ps1','otimizadorpc.ps1.sha256','otimizadorpc-portatil.ps1','rodar-portatil.bat')) {
              if (-not (Test-Path -LiteralPath (Join-Path 'dist' $arq) -PathType Leaf)) { throw "Arquivo ausente: $arq" }
          }
          $hash = (Get-FileHash -LiteralPath 'dist\otimizadorpc.ps1' -Algorithm SHA256).Hash
          $esperado = ((Get-Content -LiteralPath 'dist\otimizadorpc.ps1.sha256' -Raw).Trim() -split '\s+')[0]
          if ($hash -ne $esperado) { throw 'SHA256 divergente.' }
          foreach ($arq in @('dist\otimizadorpc.ps1','dist\otimizadorpc-portatil.ps1')) {
              $erros = $null
              [void][System.Management.Automation.Language.Parser]::ParseFile((Resolve-Path $arq).Path, [ref]$null, [ref]$erros)
              if (@($erros).Count -gt 0) { throw ('Erro de sintaxe: ' + ($erros.Message -join '; ')) }
          }
        timeout-minutes: 5

      - name: Simular a versao portatil
        shell: powershell
        run: |
          powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\dist\otimizadorpc-portatil.ps1 -Cli seguro -Simular
          if ($LASTEXITCODE -ne 0) { throw 'Simulacao portatil falhou.' }
          powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\dist\otimizadorpc-portatil.ps1 -Cli agressivo -Simular
          if ($LASTEXITCODE -ne 0) { throw 'Simulacao agressiva falhou.' }
        timeout-minutes: 10

      - name: Validar o script online em memoria e o WPF
        shell: powershell
        run: |
          $ErrorActionPreference = 'Stop'
          $codigo = [IO.File]::ReadAllText((Resolve-Path 'dist\otimizadorpc.ps1').Path)
          & ([scriptblock]::Create($codigo)) -Cli essencial -Simular
          & ([scriptblock]::Create($codigo)) -ValidarInterface
          $journals = @(Get-ChildItem "$env:ProgramData\otimizadorpc\desfazer" -Filter '*.json' -ErrorAction SilentlyContinue)
          if ($journals.Count -gt 0) { throw 'A simulacao criou journals.' }
        timeout-minutes: 10

      - name: Guardar todos os arquivos de publicacao
        uses: actions/upload-artifact@v4
        with:
          name: otimizadorpc-release
          if-no-files-found: error
          path: |
            dist/otimizadorpc.ps1
            dist/otimizadorpc.ps1.sha256
            dist/otimizadorpc-portatil.ps1
            dist/rodar-portatil.bat

  integracao:
    name: Testar aplicacao e reversao reais em runner descartavel
    needs: preparar
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ needs.preparar.outputs.sha }}
          persist-credentials: false
      - name: Integracao real
        shell: powershell
        run: |
          powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\testes\integracao.ps1
          if ($LASTEXITCODE -ne 0) { throw 'Integracao falhou.' }
        timeout-minutes: 20

  publicar:
    name: Criar release somente apos aprovacao dos testes
    needs: [preparar, compilar, integracao]
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/download-artifact@v4
        with:
          name: otimizadorpc-release
          path: dist

      - name: Conferir integridade e publicar
        shell: bash
        env:
          GH_TOKEN: ${{ github.token }}
          TAG: ${{ inputs.tag }}
          CANAL: ${{ inputs.canal }}
          SOURCE_SHA: ${{ needs.preparar.outputs.sha }}
        run: |
          set -euo pipefail
          cd dist
          tr -d '\r' < otimizadorpc.ps1.sha256 | sha256sum --check -
          cd ..
          # Nao sobrescreve releases nem reutiliza tags ja existentes.
          set +e
          git ls-remote --exit-code --tags "https://github.com/$GITHUB_REPOSITORY.git" "refs/tags/$TAG"
          status=$?
          set -e
          if [[ "$status" != '2' ]]; then
            echo 'Tag ja existente ou falha ao consulta-la. Publicacao cancelada.'
            exit 1
          fi
          flags=(--prerelease --latest=false)
          if [[ "$CANAL" == 'estavel' ]]; then flags=(--latest); fi
          gh release create "$TAG" \
            dist/otimizadorpc.ps1 \
            dist/otimizadorpc.ps1.sha256 \
            dist/otimizadorpc-portatil.ps1 \
            dist/rodar-portatil.bat \
            --repo "$GITHUB_REPOSITORY" \
            --target "$SOURCE_SHA" \
            --title "OtimizadorPC $TAG" \
            --notes "Compilacao e testes automatizados aprovados. Commit: $SOURCE_SHA. Canal: $CANAL." \
            "${flags[@]}"
          echo "Release: https://github.com/$GITHUB_REPOSITORY/releases/tag/$TAG" >> "$GITHUB_STEP_SUMMARY"

