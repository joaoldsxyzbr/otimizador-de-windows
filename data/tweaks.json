    {
      "id": "svchost-splitting",
      "nome": "Desativar divisao do svchost.exe",
      "desc": "Reduz o numero de processos svchost e o uso de memoria. Recomendado em PCs com 12 GB de RAM ou menos. Pode interferir em servicos Xbox. Precisa reiniciar. Somente manual: a reversao deste comando nao garante o estado anterior exato.",
      "verificar": "$v = (Get-ItemProperty 'HKLM:\\SYSTEM\\CurrentControlSet\\Control' -Name SvcHostSplitThresholdInKB -ErrorAction SilentlyContinue).SvcHostSplitThresholdInKB; ($null -ne $v) -and ($v -ne 3670016)",
      "categoria": "Desempenho",
      "niveis": [
        "agressivo"
      ],
      "so": "ambos",
      "acoes": [
        {
          "tipo": "comando",
          "executar": "$mem = (Get-CimInstance Win32_PhysicalMemory | Measure-Object Capacity -Sum).Sum / 1KB; Set-ItemProperty -Path 'HKLM:\\SYSTEM\\CurrentControlSet\\Control' -Name SvcHostSplitThresholdInKB -Value $mem -Type DWord",
          "reverter": "Set-ItemProperty -Path 'HKLM:\\SYSTEM\\CurrentControlSet\\Control' -Name SvcHostSplitThresholdInKB -Value 3670016 -Type DWord -Force"
        }
      ],
      "apenasManual": true
    },
