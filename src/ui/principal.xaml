<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OtimizadorPC - app de otimizacao do joao"
        Height="780" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#131316"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#22222a"/>
            <Setter Property="Foreground" Value="#e5e7eb"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#2c2c36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="BorderBrush" Value="#4b5563"/>
                                <Setter TargetName="fundo" Property="Opacity" Value="0.95"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="fundo" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="fundo" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavBotao" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9ca3af"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundoNav" Background="Transparent" CornerRadius="6" Padding="10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle x:Name="barra" Grid.Column="0" Width="3" RadiusX="1.5" RadiusY="1.5" Fill="#3b82f6" Margin="-10,8,9,8" Visibility="Collapsed"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundoNav" Property="Background" Value="#1c1c24"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="ativo">
                                <Setter TargetName="fundoNav" Property="Background" Value="#20202a"/>
                                <Setter TargetName="barra" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="#f3f4f6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BotaoVerde" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#15803d"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="BotaoVermelho" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#b91c1c"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="BotaoAzul" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1d4ed8"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="TituloPagina" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#f3f4f6"/>
        </Style>
        <Style x:Key="SubTitulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#9ca3af"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="RotuloInfo" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9ca3af"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="140"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="ValorInfo" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#f3f4f6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- checkbox vira interruptor (estilo winutil) -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#e5e7eb"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="pista" Width="34" Height="18" CornerRadius="9" Background="#3a3a45" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Ellipse x:Name="bola" Width="12" Height="12" Fill="#ffffff" HorizontalAlignment="Left" Margin="2,0,0,0" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="pista" Property="Background" Value="#3b82f6"/>
                                <Setter TargetName="bola" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="bola" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- itens de lista escuros com selecao azul -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#e5e7eb"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="borda" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="borda" Property="Background" Value="#23232d"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="borda" Property="Background" Value="#1c2f52"/>
                                <Setter Property="Foreground" Value="#dbeafe"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- scrollbar fina e escura -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#3a3a45" CornerRadius="4" Margin="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="Height" Value="9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- campos de texto: borda azul ao focar -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#22222a"/>
            <Setter Property="Foreground" Value="#e5e7eb"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="CaretBrush" Value="#3b82f6"/>
            <Setter Property="SelectionBrush" Value="#1d4ed8"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#3b82f6"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="215"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== barra lateral ===== -->
        <Border Grid.Column="0" Background="#17171b" BorderBrush="#26262c" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,20,10,0">
                    <TextBlock Text="OTIMIZADOR" FontSize="20" FontWeight="Bold" Foreground="#f3f4f6"/>
                    <TextBlock Text="PC" FontSize="20" FontWeight="Bold" Foreground="#3b82f6"/>
                    <TextBlock Text="estilo winutil, feito pro joao" FontSize="11" Foreground="#6b7280" Margin="0,2,0,18" TextWrapping="Wrap"/>
                    <Button x:Name="BotaoNavInicio" Style="{StaticResource NavBotao}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#3b82f6" VerticalAlignment="Center" Margin="2,0,10,0"/>
                            <TextBlock Text="Inicio" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BotaoNavAjustes" Style="{StaticResource NavBotao}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#3b82f6" VerticalAlignment="Center" Margin="2,0,10,0"/>
                            <TextBlock Text="Ajustes e tweaks" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BotaoNavDebloat" Style="{StaticResource NavBotao}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#3b82f6" VerticalAlignment="Center" Margin="2,0,10,0"/>
                            <TextBlock Text="Debloat (apps MS)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BotaoNavDesinstalar" Style="{StaticResource NavBotao}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#3b82f6" VerticalAlignment="Center" Margin="2,0,10,0"/>
                            <TextBlock Text="Desinstalar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BotaoNavInstalar" Style="{StaticResource NavBotao}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#3b82f6" VerticalAlignment="Center" Margin="2,0,10,0"/>
                            <TextBlock Text="Instalar apps" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BotaoNavConfig" Style="{StaticResource NavBotao}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#3b82f6" VerticalAlignment="Center" Margin="2,0,10,0"/>
                            <TextBlock Text="Config e recursos" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BotaoNavAtualizacoes" Style="{StaticResource NavBotao}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#3b82f6" VerticalAlignment="Center" Margin="2,0,10,0"/>
                            <TextBlock Text="Atualizacoes" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BotaoNavManutencao" Style="{StaticResource NavBotao}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#3b82f6" VerticalAlignment="Center" Margin="2,0,10,0"/>
                            <TextBlock Text="Manutencao" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BotaoNavDesfazer" Style="{StaticResource NavBotao}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#3b82f6" VerticalAlignment="Center" Margin="2,0,10,0"/>
                            <TextBlock Text="Desfazer tudo" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Margin="16,0,10,14" FontSize="11" Foreground="#6b7280" Text="v1.3 - use por sua conta e risco"/>
            </DockPanel>
        </Border>

        <!-- ===== area principal ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="170"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">

                <!-- pagina: inicio -->
                <Grid x:Name="PaginaInicio" Visibility="Visible">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,18,24,10">
                            <TextBlock Style="{StaticResource TituloPagina}" Text="Inicio"/>
                            <TextBlock Style="{StaticResource SubTitulo}" Margin="0,2,0,14" Text="Visao geral do seu PC. Revise os ajustes em simulacao. A aba Desfazer registra as alteracoes recuperaveis; algumas exigem revisao manual."/>
                            <GroupBox Header="Informacoes do sistema" Foreground="#93c5fd" BorderBrush="#374151" Margin="0,6,0,4">
                                <StackPanel Margin="6,6,0,6">
                                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Style="{StaticResource RotuloInfo}" Text="Computador"/><TextBlock x:Name="InfoHost" Style="{StaticResource ValorInfo}" Text="..."/></StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Style="{StaticResource RotuloInfo}" Text="Windows"/><TextBlock x:Name="InfoSo" Style="{StaticResource ValorInfo}" Text="..."/></StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Style="{StaticResource RotuloInfo}" Text="Processador"/><TextBlock x:Name="InfoCpu" Style="{StaticResource ValorInfo}" Text="..."/></StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Style="{StaticResource RotuloInfo}" Text="Placa de video"/><TextBlock x:Name="InfoGpu" Style="{StaticResource ValorInfo}" Text="..."/></StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Style="{StaticResource RotuloInfo}" Text="Memoria RAM"/><TextBlock x:Name="InfoRam" Style="{StaticResource ValorInfo}" Text="..."/></StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Style="{StaticResource RotuloInfo}" Text="Disco do sistema"/><TextBlock x:Name="InfoDisco" Style="{StaticResource ValorInfo}" Text="..."/></StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Style="{StaticResource RotuloInfo}" Text="Ligado ha"/><TextBlock x:Name="InfoUptime" Style="{StaticResource ValorInfo}" Text="..."/></StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Style="{StaticResource RotuloInfo}" Text="Restauracao"/><TextBlock x:Name="InfoRestore" Style="{StaticResource ValorInfo}" Text="..."/></StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Style="{StaticResource RotuloInfo}" Text="Ambiente"/><TextBlock x:Name="InfoAmbiente" Style="{StaticResource ValorInfo}" Text="..."/></StackPanel>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="Saude do PC - analise e proximos passos" Foreground="#93c5fd" BorderBrush="#374151" Margin="0,10,0,4">
                                <StackPanel Margin="6,8">
                                    <TextBlock x:Name="InfoDiagnostico" Foreground="#d1d5db" TextWrapping="Wrap" Text="Coletando informacoes..."/>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button x:Name="BotaoAtualizarInicio" Content="Atualizar analise" Margin="0,0,8,4"/>
                                        <Button x:Name="BotaoCancelarInicio" Content="Cancelar analise" IsEnabled="False" Margin="0,0,8,4"/>
                                    </WrapPanel>
                                    <Button x:Name="BotaoInventario" Content="Inventario e ferramentas do Windows" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                    <Button x:Name="BotaoCarga" Content="Teste de carga padronizado (CPU e memoria)" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                                    <Button x:Name="BotaoDiagnosticoAvancado" Content="Diagnostico de discos, dispositivos e eventos" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                                    <Button x:Name="BotaoResumoBateria" Content="Bateria: capacidade e carga" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                                    <Button x:Name="BotaoResumoDriversPnP" Content="Dispositivos presentes e drivers" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                                    <Button x:Name="BotaoGargalosLocais" Content="Amostras de CPU, memoria e disco" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                                    <Button x:Name="BotaoMonitor" Content="Monitor de recursos (10 amostras)" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                                    <Button x:Name="BotaoMedicoes" Content="Comparar antes e depois dos ajustes" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                                    <Button x:Name="BotaoVerificarRelease" Content="Consultar e baixar versao oficial" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="Sugestao de uso" Foreground="#93c5fd" BorderBrush="#374151" Margin="0,10,0,4">
                                <StackPanel Margin="6,8,6,10">
                                    <TextBlock Foreground="#d1d5db" FontSize="13" TextWrapping="Wrap" Text="1. Crie um ponto de restauracao antes de mexer (botao abaixo). 2. Va em Ajustes, marque o preset Seguro e aplique. 3. Use Debloat para tirar apps inuteis da Microsoft. 4. Instale seus programas pela aba Instalar. 5. Passadas de manutencao ficam na aba Manutencao."/>
                                    <Button x:Name="BotaoCriarRestore" Style="{StaticResource BotaoAzul}" Content="Criar ponto de restauracao agora" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- pagina: ajustes -->
                <Grid x:Name="PaginaAjustes" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="24,18,24,4">
                        <TextBlock Style="{StaticResource TituloPagina}" Text="Ajustes e tweaks"/>
                        <TextBlock Style="{StaticResource SubTitulo}" Text="Passe o mouse para ver finalidade, impacto, compatibilidade e recuperacao. Recomendado explica o perfil e ignora ajustes ja aplicados. Nenhum ganho de desempenho e garantido." TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,10,0,4">
                            <TextBlock Text="Marcar preset:" VerticalAlignment="Center" Foreground="#9ca3af" Margin="0,0,8,0"/>
                            <Button x:Name="BotaoPresetSeguro" Content="Basico" Margin="0,0,6,0" MinWidth="95"/>
                            <Button x:Name="BotaoPresetBalanceado" Content="Balanceado" Margin="0,0,6,0" MinWidth="95"/>
                            <Button x:Name="BotaoPresetAgressivo" Content="Amplo (revise)" Margin="0,0,14,0" MinWidth="95"/>
                            <CheckBox x:Name="ChkPontoRestore" IsChecked="True" Margin="0,0,14,0" Foreground="#e5e7eb" Content="Criar ponto de restauracao antes" ToolTip="Recomendado: cria um ponto do sistema antes de aplicar os ajustes, caso algo de errado."/>
                            <CheckBox x:Name="ChkSimularAjustes" IsChecked="True" Margin="0,0,14,0" Foreground="#e5e7eb" Content="Simular" ToolTip="Marca e clica em aplicar: escreve no log tudo o que faria, sem alterar nada no pc. Ideal antes de rodar no pc do trabalho."/>
                            <Button x:Name="BotaoAplicarAjustes" Style="{StaticResource BotaoVerde}" Content="Aplicar ajustes selecionados" MinWidth="210" Margin="0,0,8,4"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,4,0,4">
                            <TextBlock Text="Perfis:" VerticalAlignment="Center" Foreground="#9ca3af" Margin="0,0,8,0"/>
                            <Button x:Name="BotaoPerfilRecomendado" Content="Recomendado" Margin="0,2,6,2" ToolTip="Seleciona preferencias essenciais sem inferir ganho de desempenho ou tipo de computador."/>
                            <Button x:Name="BotaoPerfilEssencial" Content="Essencial" Margin="0,2,6,2"/>
                            <Button x:Name="BotaoPerfilGamer" Content="Gamer" Margin="0,2,6,2" ToolTip="Preferencias de mouse e conveniencia; nao promete FPS."/>
                            <Button x:Name="BotaoPerfilNotebook" Content="Notebook" Margin="0,2,6,2" ToolTip="Ajustes leves, sem forcar alto desempenho."/>
                            <Button x:Name="BotaoPerfilPrivacidade" Content="Privacidade" Margin="0,2,6,2"/>
                            <Button x:Name="BotaoPerfilCorporativo" Content="Corporativo" Margin="0,2,6,2" ToolTip="Apenas exibe extensoes de arquivos. Consulte o administrador."/>
                        </WrapPanel>
                        <WrapPanel Margin="0,4,0,0">
                            <TextBlock Text="filtrar:" Foreground="#9ca3af" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
                            <TextBox x:Name="FiltroAjustes" Width="280" Height="30" Background="#22222a" Foreground="#e5e7eb" BorderBrush="#374151" Padding="6,4" VerticalContentAlignment="Center" ToolTip="filtra pelo nome ou descricao; campo vazio mostra tudo"/>
                            <TextBlock Text="(verde = ja aplicado | amarelo = parcial)" Foreground="#6b7280" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12"/>
                            <Button x:Name="BotaoExportarPlano" Style="{StaticResource BotaoAzul}" Content="Exportar plano" MinWidth="115" Margin="16,0,0,0" ToolTip="salva em um .json os ajustes marcados agora; da pra importar em outro pc ou repetir depois."/>
                            <Button x:Name="BotaoImportarPlano" Style="{StaticResource BotaoAzul}" Content="Importar plano" MinWidth="115" Margin="8,0,0,0" ToolTip="abre um plano exportado e marca os ajustes correspondentes na lista (nao aplica nada sozinho)."/>
                        </WrapPanel>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="24,6,14,10">
                        <StackPanel>
                            <WrapPanel Margin="0,0,0,8"><Button x:Name="BotaoAtualizarAjustes" Content="Atualizar estados" Margin="0,0,8,4"/><Button x:Name="BotaoCancelarAjustes" Content="Cancelar consulta" IsEnabled="False" Margin="0,0,8,4"/></WrapPanel>
                            <TextBlock x:Name="InfoConsultaAjustes" Foreground="#9ca3af" TextWrapping="Wrap" Text="Inventario ainda nao consultado." Margin="0,0,0,8"/>
                            <StackPanel x:Name="ListaAjustes"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- pagina: debloat -->
                <Grid x:Name="PaginaDebloat" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="24,18,24,4">
                        <TextBlock Style="{StaticResource TituloPagina}" Text="Debloat - apps pre-instalados"/>
                        <TextBlock Style="{StaticResource SubTitulo}" Text="Identifica apps opcionais, uteis, protegidos e nao catalogados. Somente apps catalogados e instalados podem ser removidos do usuario atual. Nenhum item vem marcado. Consulte a finalidade e a recuperacao ao passar o mouse." TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,10,0,4">
                            <CheckBox x:Name="ChkPontoRestoreUwp" IsChecked="True" Margin="0,0,14,0" Foreground="#e5e7eb" Content="Criar ponto de restauracao antes"/>
                            <Button x:Name="BotaoRemoverUwp" IsEnabled="False" Style="{StaticResource BotaoVermelho}" Content="Remover apps selecionados" MinWidth="210" Margin="0,0,8,4"/>
                            <Button x:Name="BotaoAtualizarUwp" Content="Atualizar" Margin="0,0,8,4"/>
                            <Button x:Name="BotaoCancelarUwp" Content="Cancelar consulta" IsEnabled="False" Margin="0,0,8,4"/>
                        </WrapPanel>
                        <TextBlock x:Name="InfoConsultaUwp" Text="Inventario ainda nao consultado." TextWrapping="Wrap" Foreground="#9ca3af" Margin="0,4,0,4"/>
                        <WrapPanel Margin="0,4,0,0">
                            <TextBlock Text="filtrar:" Foreground="#9ca3af" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
                            <TextBox x:Name="FiltroUwp" Width="280" Height="30" Background="#22222a" Foreground="#e5e7eb" BorderBrush="#374151" Padding="6,4" VerticalContentAlignment="Center" ToolTip="filtra pelo nome ou descricao; campo vazio mostra tudo"/>
                            <TextBlock Text="(cinza = indisponivel ou protegido)" Foreground="#6b7280" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12"/>
                        </WrapPanel>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="24,6,14,10">
                        <StackPanel x:Name="ListaUwp"/>
                    </ScrollViewer>
                </Grid>

                <!-- pagina: desinstalar -->
                <Grid x:Name="PaginaDesinstalar" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1.5*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="24,18,24,4">
                        <TextBlock Style="{StaticResource TituloPagina}" Text="Desinstalar apps"/>
                        <TextBlock Style="{StaticResource SubTitulo}" Text="Identifique programas, dependencias e componentes protegidos. A classificacao local e indicativa. Desinstale antes de limpar rastros; a recuperacao pode exigir revisao manual." TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,10,0,4">
                            <TextBlock Text="filtrar:" Foreground="#9ca3af" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
                            <TextBox x:Name="FiltroDesinstalar" Width="280" Height="30" Background="#22222a" Foreground="#e5e7eb" BorderBrush="#374151" Padding="6,4" VerticalContentAlignment="Center" ToolTip="filtra pelo nome, editor ou versao"/>
                            <Button x:Name="BotaoAtualizarProgramas" Content="Atualizar lista" Margin="8,0,0,0" MinWidth="120"/>
                            <Button x:Name="BotaoCancelarProgramas" Content="Cancelar consulta" IsEnabled="False" Margin="8,0,0,0"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,4,0,4">
                            <ComboBox x:Name="CategoriaDesinstalar" Width="150" SelectedIndex="0" Margin="0,0,8,4" ToolTip="Categoria">
                                <ComboBoxItem Content="Todas as categorias" Tag="Todos"/>
                                <ComboBoxItem Content="Aplicativos" Tag="Aplicativo"/>
                                <ComboBoxItem Content="Opcionais" Tag="Opcional"/>
                                <ComboBoxItem Content="Sistema protegido" Tag="Sistema"/>
                                <ComboBoxItem Content="Drivers" Tag="Driver"/>
                                <ComboBoxItem Content="Dependencias" Tag="Dependencia"/>
                                <ComboBoxItem Content="Seguranca" Tag="Seguranca"/>
                                <ComboBoxItem Content="Desconhecidos" Tag="Desconhecido"/>
                            </ComboBox>
                            <ComboBox x:Name="OrdemDesinstalar" Width="150" SelectedIndex="0" Margin="0,0,8,4" ToolTip="Ordenacao">
                                <ComboBoxItem Content="Nome (A-Z)" Tag="Nome"/>
                                <ComboBoxItem Content="Maior tamanho" Tag="Tamanho"/>
                                <ComboBoxItem Content="Instalacao recente" Tag="Data"/>
                            </ComboBox>
                            <Button x:Name="BotaoDetalhesPrograma" Content="Detalhes" IsEnabled="False" Margin="0,0,8,4"/>
                            <TextBlock x:Name="InfoProgramas" Foreground="#9ca3af" VerticalAlignment="Center" Text="Inventario ainda nao consultado" TextWrapping="Wrap"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,4,0,0">
                            <CheckBox x:Name="ChkPontoRestoreDesinstalar" IsChecked="True" Margin="0,0,14,0" Foreground="#e5e7eb" VerticalAlignment="Center" Content="Criar ponto de restauracao antes"/>
                            <Button x:Name="BotaoDesinstalarProg" IsEnabled="False" Style="{StaticResource BotaoVermelho}" Content="Desinstalar selecionado(s)" Margin="0,0,8,0" MinWidth="200"/>
                            <Button x:Name="BotaoVarrerRastros" IsEnabled="False" Style="{StaticResource BotaoAzul}" Content="Varrer rastros do selecionado" MinWidth="210" ToolTip="Procura pastas, registro, atalhos, servicos, tarefas agendadas, firewall, inicializacao (run) e PATH com o nome do programa. Um programa por vez." Margin="0,0,8,4"/>
                        </WrapPanel>
                        <TextBlock x:Name="DetalhePrograma" Foreground="#93c5fd" TextWrapping="Wrap" MaxHeight="52" Margin="0,4,0,0" Text="Selecione uma entrada para ver a finalidade e o risco."/>
                    </StackPanel>
                    <ListBox x:Name="ListaProgramas" Grid.Row="1" Background="#1b1b20" Foreground="#e5e7eb" BorderBrush="#374151" Margin="24,6,14,4" FontSize="13" SelectionMode="Extended" ToolTip="Ctrl+clique seleciona varios"/>
                    <StackPanel Grid.Row="2" Margin="24,8,14,4">
                        <TextBlock x:Name="RotuloRastros" Text="rastros: selecione um programa acima e clique em varrer." Foreground="#9ca3af" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,6,0,0">
                        <Button x:Name="BotaoMarcarRastros" Content="Marcar todos" Margin="0,0,0,0" MinWidth="110" VerticalAlignment="Center"/>
                        <Button x:Name="BotaoDesmarcarRastros" Content="Desmarcar todos" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="InfoMarcadosRastros" Text="0 marcado(s)" Foreground="#93c5fd" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <Button x:Name="BotaoApagarRastros" Style="{StaticResource BotaoVermelho}" Content="Apagar selecionados (pra quarantena)" Margin="12,0,0,0" MinWidth="270" VerticalAlignment="Center"/>
                        </WrapPanel>
                    </StackPanel>
                    <ListBox x:Name="ListaRastros" Grid.Row="3" Background="#1b1b20" Foreground="#e5e7eb" BorderBrush="#374151" Margin="24,2,14,10" FontSize="13" SelectionMode="Extended" ToolTip="Marque as caixas dos rastros que deseja remover. O realce azul nao e uma marcacao."/>
                </Grid>

                <!-- pagina: instalar -->
                <Grid x:Name="PaginaInstalar" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="24,18,24,4">
                        <TextBlock Style="{StaticResource TituloPagina}" Text="Instalar aplicativos"/>
                        <TextBlock Style="{StaticResource SubTitulo}" Text="Instale ou atualize apps selecionados via WinGet, com ID e fonte explicitos. Nenhum app vem marcado. Consulte as versoes antes de atualizar." TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,10,0,4">
                            <Button x:Name="BotaoMarcarPadroes" Content="Sugerir aplicativos" Margin="0,0,8,0" MinWidth="140"/>
                            <Button x:Name="BotaoInstalarApps" Style="{StaticResource BotaoVerde}" Content="Instalar selecionados" Margin="0,0,8,0" MinWidth="170"/>
                            <Button x:Name="BotaoAtualizarSelecionados" Content="Atualizar selecionados" Margin="0,0,8,4"/>
                            <Button x:Name="BotaoAtualizarTudo" Style="{StaticResource BotaoAzul}" Content="Consultar atualizacoes" MinWidth="180" Margin="0,0,8,4"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,4,0,0">
                            <TextBlock Text="filtrar:" Foreground="#9ca3af" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
                            <TextBox x:Name="FiltroApps" Width="280" Height="30" Background="#22222a" Foreground="#e5e7eb" BorderBrush="#374151" Padding="6,4" VerticalContentAlignment="Center" ToolTip="filtra pelo nome ou descricao; campo vazio mostra tudo"/>
                        </WrapPanel>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="24,6,14,10">
                        <StackPanel x:Name="ListaApps"/>
                    </ScrollViewer>
                </Grid>

                <!-- pagina: config -->
                <Grid x:Name="PaginaConfig" Visibility="Collapsed">
                    <Grid Margin="24,18,24,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource TituloPagina}" Text="Config, recursos e correcoes"/>
                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.1*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Margin="0,0,10,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" FontSize="15" FontWeight="SemiBold" Foreground="#f3f4f6" Margin="0,0,0,4" Text="Recursos do Windows (habilitar)"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,6,0">
                                    <StackPanel Margin="0,0,8,0">
                                        <WrapPanel Margin="0,0,0,8"><Button x:Name="BotaoAtualizarRecursos" Content="Atualizar recursos" Margin="0,0,8,4"/><Button x:Name="BotaoCancelarRecursos" Content="Cancelar consulta" IsEnabled="False" Margin="0,0,8,4"/></WrapPanel>
                                        <TextBlock x:Name="InfoConsultaRecursos" Foreground="#9ca3af" TextWrapping="Wrap" Text="Inventario ainda nao consultado." Margin="0,0,0,8"/>
                                        <StackPanel x:Name="ListaRecursos"/>
                                    </StackPanel>
                                </ScrollViewer>
                                <Button x:Name="BotaoInstalarRecursos" Style="{StaticResource BotaoVerde}" Grid.Row="2" HorizontalAlignment="Left" Margin="0,8,0,0" Content="Habilitar recursos selecionados" MinWidth="220"/>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#f3f4f6" Text="Correcoes comuns"/>
                                <Button x:Name="BotaoTema" Content="Alternar tema claro/escuro (ao reabrir)" Margin="0,6,0,6"/>
                                <StackPanel Margin="0,8,0,0">
                                    <Button x:Name="BotaoFixUpdate" HorizontalAlignment="Stretch" Margin="0,0,0,6" Content="Diagnosticar Windows Update nas Configuracoes"/>
                                    <Button x:Name="BotaoFixRede" HorizontalAlignment="Stretch" Margin="0,0,0,6" Content="Diagnosticar rede nas Configuracoes"/>
                                    <Button x:Name="BotaoFixIntegridade" HorizontalAlignment="Stretch" Margin="0,0,0,6" Content="Verificar integridade do sistema (DISM + SFC)"/>
                                    <Button x:Name="BotaoFixWinget" HorizontalAlignment="Stretch" Content="Instalar/reparar o winget"/>
                                </StackPanel>
                                <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#f3f4f6" Margin="0,16,0,4" Text="Paineis classicos do windows"/>
                                <WrapPanel x:Name="PainelLegado" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- pagina: atualizacoes -->
                <Grid x:Name="PaginaAtualizacoes" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,18,24,10">
                            <TextBlock Style="{StaticResource TituloPagina}" Text="Atualizacoes do Windows"/>
                            <TextBlock Style="{StaticResource SubTitulo}" Margin="0,2,0,12" Text="Consulte as politicas registradas e o historico local. Nao alteramos politicas de atualizacao; use as configuracoes oficiais do Windows."/>
                            <WrapPanel>
                                <CheckBox x:Name="ChkBloquearDrivers" IsThreeState="True" IsEnabled="False" Foreground="#e5e7eb" Margin="0,0,18,0" IsChecked="False" Content="Nao baixar drivers pelo Windows Update" ToolTip="Drivers de video etc. continuarao instalados apenas por voce. Util quando o wu insiste num driver ruim."/>
                                <CheckBox x:Name="ChkAdiarRecursos" IsThreeState="True" IsEnabled="False" Foreground="#e5e7eb" IsChecked="False" Content="Adiar versoes novas do Windows em 180 dias" ToolTip="Deixa o windows atualizar apenas com correcoes de seguranca enquanto a versao nova 'assenta'. Drivers e correcoes seguem normal."/>
                            </WrapPanel>
                            <WrapPanel Margin="0,8,0,0"><Button x:Name="BotaoAtualizarAtualizacoes" Content="Atualizar estado" Margin="0,0,8,4"/><Button x:Name="BotaoCancelarAtualizacoes" Content="Cancelar consulta" IsEnabled="False" Margin="0,0,8,4"/></WrapPanel>
                            <TextBlock x:Name="InfoConsultaAtualizacoes" TextWrapping="Wrap" Foreground="#9ca3af"/>
                            <TextBlock x:Name="InfoPoliticasUpdate" Style="{StaticResource SubTitulo}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <WrapPanel Margin="0,14,0,0">
                                <Button x:Name="BotaoAplicarAtualizacoes" Style="{StaticResource BotaoAzul}" Content="Consultar historico" Margin="0,0,10,0" MinWidth="120"/>
                                <Button x:Name="BotaoBuscarAtualizacoes" Content="Abrir Windows Update" Margin="0,0,10,0" MinWidth="150"/>
                                <Button x:Name="BotaoResetUpdate2" Content="Diagnosticar Windows Update" MinWidth="170" ToolTip="Abre o Windows Update sem alterar servicos, caches ou politicas." Margin="0,0,8,4"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource SubTitulo}" Margin="0,14,0,0" Text="As caixas apenas exibem valores registrados, nao a politica efetiva. Historico nao realiza busca online nem instala atualizacoes."/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- pagina: manutencao -->
                <Grid x:Name="PaginaManutencao" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,18,24,10">
                            <TextBlock Style="{StaticResource TituloPagina}" Text="Manutencao"/>
                            <TextBlock Style="{StaticResource SubTitulo}" Margin="0,2,0,12" Text="Rotinas de limpeza e diagnostico. As marcadas com (janela) rodam numa janela separada do powershell para voce acompanhar tudo em tempo real."/>
                            <UniformGrid Columns="2" Margin="0,4,0,0">
                                <Button x:Name="BotaoLimparTemp" Content="Analisar e limpar temporarios" Margin="4" Padding="10,14" ToolTip="Mostra estimativa e pede confirmacao. Arquivos antigos na raiz Temp do usuario; exclusao definitiva. Nao limpa Temp do Windows."/>
                                <Button x:Name="BotaoLimpezaDisco" Content="Revisar limpeza de disco (Windows)" Margin="4" Padding="10,14" ToolTip="Abre limpeza nativa do Windows. Revise as categorias; exclusao pode ser definitiva."/>
                                <Button x:Name="BotaoAnalisarComponentes" Content="Analisar componentes do Windows" Margin="4" Padding="10,14" ToolTip="DISM AnalyzeComponentStore: avalia armazenamento antes da limpeza."/>
                                <Button x:Name="BotaoDiagnosticarIntegridade" Content="Diagnosticar integridade (sem reparo)" Margin="4" Padding="10,14" ToolTip="DISM ScanHealth e SFC verifyonly; consulta pode gravar logs do Windows."/>
                                <Button x:Name="BotaoOtimizarVolume" Content="Analisar e otimizar unidades (Windows)" Margin="4" Padding="10,14" ToolTip="Abre Otimizar Unidades nativo; nenhuma operacao automatica ou forcada."/>
                                <Button x:Name="BotaoConsultarEnergia" Content="Diagnosticar energia e suspensao" Margin="4" Padding="10,14" ToolTip="Consulta plano, solicitacoes, ultima ativacao e temporizadores."/>
                                <Button x:Name="BotaoLimpezaDism" Content="Limpeza de componentes do Windows (janela)" Margin="4" Padding="10,14" ToolTip="Remove componentes substituidos do Windows. Pode demorar; nao use como rotina de ganho de FPS."/>
                                <Button x:Name="BotaoVerificarIntegridade" Content="Reparar arquivos do sistema (DISM + SFC)" Margin="4" Padding="10,14" ToolTip="DISM e SFC tentam reparar arquivos do sistema; use quando houver corrupcao ou falhas."/>
                                <Button x:Name="BotaoVerificarDisco" Content="Verificar volume do sistema (sem reparo)" Margin="4" Padding="10,14" ToolTip="Consulta o volume do sistema; pode consumir recursos."/>
                                <Button x:Name="BotaoRecuperarIcones" Content="Reconstruir cache de icones" Margin="4" Padding="10,14" ToolTip="Use quando icones estiverem incorretos; reinicia o Explorer."/>
                                <Button x:Name="BotaoLimparDns" Content="Limpar cache do DNS" Margin="4" Padding="10,14" ToolTip="Use em problemas de resolucao de nomes; nao acelera a internet permanentemente."/>
                                <Button x:Name="BotaoSincronizarHora" Content="Sincronizar hora pela fonte configurada" Margin="4" Padding="10,14" ToolTip="Use se a hora estiver incorreta. Depende do servico de hora."/>
                                <Button x:Name="BotaoAnalisarArmazenamento" Content="Analisar arquivos grandes" Margin="4" Padding="10,14" ToolTip="Analise somente leitura. Arquivos grandes nao sao necessariamente descartaveis."/>
                                <Button x:Name="BotaoBackupDrivers" Content="Exportar backup de drivers" Margin="4" Padding="10,14" ToolTip="Exporta drivers de terceiros para uma pasta escolhida, sem instalar nem remover drivers."/>
                            </UniformGrid>
                            <TextBlock Style="{StaticResource SubTitulo}" Margin="0,14,0,0" Text="Use reparos conforme o sintoma. Analise antes de limpar: nem todo arquivo grande e dispensavel. Limpezas definitivas nao sao revertidas pelo journal."/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- pagina: desfazer -->
                <Grid x:Name="PaginaDesfazer" Visibility="Collapsed">
                    <Grid Margin="24,18,24,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Style="{StaticResource TituloPagina}" Text="Desfazer mudancas"/>
                            <TextBlock Style="{StaticResource SubTitulo}" Margin="0,2,0,8" Text="Cada vez que voce aplicou ajustes, debloat, recursos ou configuracoes de update, o app guardou um journal de tudo (em ProgramData\otimizadorpc-v2\desfazer). Escolha a sessao e reverta. A limpeza de rastros da aba Desinstalar tambem vira sessao aqui: desfazer devolve arquivos da quarantena e importa os backups .reg do registro. Historicos antigos ficam em ProgramData\otimizadorpc e nao sao executados nesta versao. Apps removidos podem exigir reinstalacao manual." TextWrapping="Wrap"/>
                        </StackPanel>
                        <ListBox x:Name="ListaDesfazer" Grid.Row="1" Background="#1b1b20" Foreground="#e5e7eb" BorderBrush="#374151" Margin="0,6,0,0" FontSize="13"/>
                        <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                            <Button x:Name="BotaoDesfazer" Style="{StaticResource BotaoVermelho}" Content="Desfazer sessao selecionada" Margin="0,0,10,0" MinWidth="220"/>
                            <Button x:Name="BotaoAtualizarHistorico" Content="Atualizar lista" MinWidth="130" Margin="0,0,10,4"/>
                            <Button x:Name="BotaoCancelarHistorico" Content="Cancelar consulta" IsEnabled="False" Margin="0,0,10,4"/>
                            <TextBlock x:Name="InfoConsultaHistorico" Foreground="#9ca3af" TextWrapping="Wrap" Margin="0,0,10,4"/>
                            <Button x:Name="BotaoDetalhesSessao" Content="Detalhes e quarentena" MinWidth="160" Margin="0,0,10,0"/>
                            <Button x:Name="BotaoDesfazerUma" Content="Desfazer ultima acao" MinWidth="160" Margin="0,0,10,0"/>
                            <Button x:Name="BotaoConfirmarManual" Content="Confirmar recuperacao manual" MinWidth="180"/>
                        </WrapPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!-- barra de status -->
            <Border Grid.Row="1" Background="#17171b" BorderBrush="#26262c" BorderThickness="0,1,0,0" Padding="14,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="PontoStatus" Grid.Column="0" Width="12" Height="12" Fill="#22c55e" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusTexto" Grid.Column="1" Text="pronto." Foreground="#9ca3af" FontSize="12" VerticalAlignment="Center"/>
                    <ProgressBar x:Name="BarraProgresso" Grid.Column="2" Width="160" Height="10" IsIndeterminate="False" Background="#22222a" Foreground="#3b82f6" BorderThickness="0" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- log -->
            <Border Grid.Row="2" Background="#0d0d10" BorderBrush="#26262c" BorderThickness="0,1,0,0">
                <Grid Margin="10,6,10,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="log de atividades" Foreground="#6b7280" FontSize="11" Margin="2,0,0,4"/>
                    <TextBox x:Name="LogBox" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="#a7f3d0" FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
